{
  "name": "mywallet-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API ringan MyWallet (Hono + SQLite): data publik jaringan, token, harga, dan ringkasan saldo.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:tokens": "tsx scripts/verify-tokens.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@solana/kit": "^8.4.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.12",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
