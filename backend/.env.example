# Port HTTP server
PORT=8787

# Lokasi file SQLite. Di server production arahkan ke volume persisten.
DATABASE_PATH=./data/mywallet.db

# RPC tiap jaringan. Default-nya node publik (ada batas request);
# untuk production pakai provider sendiri (Alchemy, QuickNode, Helius, dll).
RPC_URL_ETHEREUM=https://ethereum-rpc.publicnode.com
RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_POLYGON=https://polygon-bor-rpc.publicnode.com
RPC_URL_SOLANA=https://api.mainnet-beta.solana.com

# Berapa lama saldo per alamat disimpan di memori sebelum dibaca ulang (ms)
BALANCE_CACHE_TTL_MS=20000

# Batas waktu baca saldo per jaringan (ms)
RPC_TIMEOUT_MS=8000

# Harga token & kurs USD→IDR
# Harga diambil tiap interval ini (ms). Sumber: DefiLlama, cadangan CoinGecko.
PRICE_REFRESH_INTERVAL_MS=60000
# Kurs diambil tiap interval ini (ms). Sumber: Frankfurter (ECB), cadangan open.er-api.com.
FX_REFRESH_INTERVAL_MS=3600000
# Harga lebih tua dari ini ditandai isStale di GET /v1/prices (ms)
PRICE_STALE_AFTER_MS=900000
PRICE_FETCH_TIMEOUT_MS=8000
# Opsional: API key demo CoinGecko (sumber cadangan) supaya tidak gampang kena limit
COINGECKO_API_KEY=
